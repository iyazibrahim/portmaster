# --- Local (no Docker) — set these first ---
# Use any Postgres 16+ URL: Neon, Supabase, Railway, or local install.
# Neon example:
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# Local install example:
DATABASE_URL=postgresql://tiangpass:tiangpass@127.0.0.1:5432/tiangpass

# Auth.js secret (generate with: openssl rand -base64 32)
AUTH_SECRET=change-me-to-a-long-random-string

# Keep Server Action encryption stable across deploys (openssl rand -base64 32).
# Without this, open tabs after a redeploy can hit "Failed to find Server Action".
# Boarding scan/preview use /api/boarding/* so CI/CO still works after redeploy.
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Public app URL (no trailing slash) — match the port you run
APP_URL=http://127.0.0.1:43127

# Dev / process listen port
PORT=43127

# Trust host header (needed behind reverse proxies; fine for local too)
AUTH_TRUST_HOST=true

# Optional: let any account buy multiple same-day passes (testing).
# Seed anglers fisher@ / siti@tiangpass.local already allowed without this.
# ALLOW_MULTI_PASS_PER_DAY=true

# Optional: skip jetty presence check for any account (testing).
# Seed anglers already bypass without this.
# ALLOW_PASS_GEO_BYPASS=true

# Optional: protect POST /api/cron/cleanup (Bearer or x-cron-secret).
# Also run manually: npm run db:cleanup
# CRON_SECRET=change-me-long-random

# --- Stripe (primary; Admin Ops → Payment gateway = stripe) ---
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Register webhook: {APP_URL}/api/webhooks/stripe → checkout.session.completed
# Configure payment methods in Stripe Dashboard (do not hardcode in code).

# --- HitPay (optional; Admin Ops → Payment gateway = hitpay) ---
# HITPAY_API_KEY=
# HITPAY_API_URL=https://api.sandbox.hit-pay.com
# HITPAY_WEBHOOK_SALT=
# HITPAY_CURRENCY=MYR
# HITPAY_PAYMENT_METHODS=grabpay_direct,shopee_pay,atome
# Production later:
# HITPAY_API_URL=https://api.hit-pay.com
# HITPAY_PAYMENT_METHODS=fpx,duitnow
# Register webhook: {APP_URL}/api/webhooks/hitpay → payment_request.completed
# Missing Stripe/HitPay keys while Admin selects them → automatic mock fallback.
# Mock Pay buttons always remain on the pay step as Demo / fallback.

# --- Optional: Docker Compose / Dokploy only ---
# When using docker-compose.yml, point at the compose service hostname instead:
# DATABASE_URL=postgresql://tiangpass:tiangpass@postgres:5432/tiangpass
# APP_URL=http://localhost:43127

# --- GitHub Actions → Dokploy (repo Secrets, not app .env) ---
# DOKPLOY_URL=https://your-dokploy-host
# DOKPLOY_API_KEY=...
# DOKPLOY_COMPOSE_ID=...          # preferred (compose stack)
# DOKPLOY_APPLICATION_ID=...      # alternative (single Docker app)
