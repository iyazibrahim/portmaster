# --- Local (no Docker) — set these first ---
# Use any Postgres 16+ URL: Neon, Supabase, Railway, or local install.
# Neon example:
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# Local install example:
DATABASE_URL=postgresql://tiangpass:tiangpass@127.0.0.1:5432/tiangpass

# Auth.js secret (generate with: openssl rand -base64 32)
AUTH_SECRET=change-me-to-a-long-random-string

# Public app URL (no trailing slash) — match the port you run
APP_URL=http://127.0.0.1:43127

# Dev / process listen port
PORT=43127

# Trust host header (needed behind reverse proxies; fine for local too)
AUTH_TRUST_HOST=true

# Optional: let any account buy multiple same-day passes (testing).
# Seed anglers fisher@ / siti@tiangpass.local already allowed without this.
# ALLOW_MULTI_PASS_PER_DAY=true

# Optional: skip jetty presence check for any account (testing).
# Seed anglers already bypass without this.
# ALLOW_PASS_GEO_BYPASS=true

# --- Optional: Docker Compose / Dokploy only ---
# When using docker-compose.yml, point at the compose service hostname instead:
# DATABASE_URL=postgresql://tiangpass:tiangpass@postgres:5432/tiangpass
# APP_URL=http://localhost:43127
